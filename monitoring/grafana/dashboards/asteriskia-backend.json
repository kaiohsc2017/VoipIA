  "id": null,
  "panels": [
    {
      "type": "stat",
      "title": "Backend UP",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "up{job=\"asteriskia-backend\"}",
          "legendFormat": "Backend"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } }, "type": "value" }
          ],
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "HTTP Requisições / segundo",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{job=\"asteriskia-backend\"}[1m])",
          "legendFormat": "{{ uri }} {{ method }}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM Heap Usage",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\", job=\"asteriskia-backend\"}",
          "legendFormat": "Heap Used"
        },
        {
          "expr": "jvm_memory_max_bytes{area=\"heap\", job=\"asteriskia-backend\"}",
          "legendFormat": "Heap Max"
        }
      ]
    }
  ],
