{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "Tentativas de Login (1h)",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{
        "expr": "increase(http_server_requests_seconds_count{job=\"asteriskia-backend\",uri=\"/api/v1/auth/login\"}[1h])",
        "legendFormat": "logins/h"
      }],
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Logins com Erro 401 (1h)",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [{
        "expr": "increase(http_server_requests_seconds_count{job=\"asteriskia-backend\",uri=\"/api/v1/auth/login\",status=\"401\"}[1h])",
        "legendFormat": "falhas/h"
      }],
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 3 }, { "color": "red", "value": 10 }] } }
      }
    },
    {
      "type": "stat",
      "title": "Rate Limit 429 (1h)",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [{
        "expr": "increase(http_server_requests_seconds_count{job=\"asteriskia-backend\",status=\"429\"}[1h])",
        "legendFormat": "bloqueios/h"
      }],
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }
      }
    },
    {
      "type": "stat",
      "title": "Req Auditoria / min",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [{
        "expr": "sum(rate(http_server_requests_seconds_count{job=\"asteriskia-backend\",uri=~\"/api/v1/audit.*\"}[1m]))",
        "legendFormat": "req/min"
      }],
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "type": "stat",
      "title": "Req Settings / hora",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [{
        "expr": "increase(http_server_requests_seconds_count{job=\"asteriskia-backend\",uri=~\"/api/v1/settings.*\",method=\"POST\"}[1h])",
        "legendFormat": "settings POST/h"
      }],
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Uptime Backend",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "targets": [{ "expr": "process_uptime_seconds{job=\"asteriskia-backend\"}", "legendFormat": "uptime" }],
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries",
      "title": "Tentativas de Login — sucesso vs falha",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "rate(http_server_requests_seconds_count{job=\"asteriskia-backend\",uri=\"/api/v1/auth/login\",status=\"200\"}[5m])", "legendFormat": "✅ Login OK" },
        { "expr": "rate(http_server_requests_seconds_count{job=\"asteriskia-backend\",uri=\"/api/v1/auth/login\",status=\"401\"}[5m])", "legendFormat": "❌ Login Falha" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Rate Limiting — bloqueios por IP (429)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "targets": [{
        "expr": "rate(http_server_requests_seconds_count{job=\"asteriskia-backend\",status=\"429\"}[5m])",
        "legendFormat": "Bloqueios Rate Limit/s"
      }],
      "fieldConfig": {
        "defaults": { "color": { "fixedColor": "red", "mode": "fixed" } }
      }
    },
    {
      "type": "timeseries",
      "title": "Endpoints de Auditoria — volume",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "targets": [{
        "expr": "sum by (uri, method) (rate(http_server_requests_seconds_count{job=\"asteriskia-backend\",uri=~\"/api/v1/(audit|totp|users|settings).*\"}[1m]))",
        "legendFormat": "{{ method }} {{ uri }}"
      }]
    },
    {
      "type": "timeseries",
      "title": "Latência Endpoints Críticos (P95)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"asteriskia-backend\",uri=~\"/api/v1/(auth|users|settings|audit).*\"}[5m]))) * 1000",
        "legendFormat": "p95 {{ uri }}"
      }],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    }
  ],
  "schemaVersion": 38,
  "tags": ["asteriskia", "security", "audit"],
  "title": "AsteriskIA — Segurança & Auditoria",
  "uid": "asteriskia-security",
  "version": 1
}
