; =============================================================
; pjsip.conf — Configuração SIP (chan_pjsip)
; Define: transporte, tronco SIP da operadora e ramais de teste
; =============================================================

; ---------------------------------------------------------------
; TRANSPORTE UDP
; ---------------------------------------------------------------
[transport-udp]
type = transport
protocol = udp
bind = 0.0.0.0:5060
; Externaliza IPs para funcionamento correto em NAT/Cloud
; Ajuste os valores conforme o ambiente de deploy
; external_media_address = SEU_IP_PUBLICO
; external_signaling_address = SEU_IP_PUBLICO
local_net = 172.16.0.0/12
local_net = 10.0.0.0/8
local_net = 192.168.0.0/16

; ---------------------------------------------------------------
; TRANSPORTE WEBSOCKET (WebRTC via Caddy proxy)
; O Caddy termina o TLS (wss://) e repassa como ws:// para o
; Asterisk na porta 8088. O transport-ws recebe essas conexões.
; ---------------------------------------------------------------
[transport-ws]
type = transport
protocol = ws
bind = 0.0.0.0:8088
; Permite conexões de qualquer origem (Caddy proxy)
; local_net aqui não filtra — é só para referência de NAT
local_net = 172.16.0.0/12
local_net = 10.0.0.0/8
local_net = 192.168.0.0/16

; ---------------------------------------------------------------
; TRONCO SIP — Registro na operadora
; Credenciais injetadas via variável de ambiente
; ---------------------------------------------------------------
[tronco-sip-auth]
type = auth
auth_type = userpass
username = ${SIP_TRUNK_USER}
password = ${SIP_TRUNK_PASSWORD}

[tronco-sip-aor]
type = aor
contact = sip:${SIP_TRUNK_HOST}
qualify_frequency = 60

[tronco-sip]
type = endpoint
transport = transport-udp
context = recepcao-tronco
disallow = all
allow = ulaw
allow = alaw
outbound_auth = tronco-sip-auth
aors = tronco-sip-aor
from_domain = ${SIP_TRUNK_FROM_DOMAIN}

[tronco-sip-reg]
type = registration
transport = transport-udp
outbound_auth = tronco-sip-auth
server_uri = sip:${SIP_TRUNK_HOST}
client_uri = sip:${SIP_TRUNK_USER}@${SIP_TRUNK_HOST}
retry_interval = 60
max_retries = 10

; ---------------------------------------------------------------
; RAMAIS DE TESTE — Para desenvolvimento e testes locais
; Use um softphone (Zoiper / MicroSIP) com estas credenciais
; ---------------------------------------------------------------

; --- Ramal 1001 — Teste Geral ---
[ramal-1001-auth]
type = auth
auth_type = userpass
username = 1001
password = ramal1001pass

[ramal-1001-aor]
type = aor
max_contacts = 1
qualify_frequency = 30

[1001]
type = endpoint
context = ramais-internos
disallow = all
allow = ulaw
allow = alaw
auth = ramal-1001-auth
aors = ramal-1001-aor
callerid = "Teste Geral" <1001>

; --- Ramal 1002 — Teste Conectividade ---
[ramal-1002-auth]
type = auth
auth_type = userpass
username = 1002
password = ramal1002pass

[ramal-1002-aor]
type = aor
max_contacts = 1
qualify_frequency = 30

[1002]
type = endpoint
context = ramais-internos
disallow = all
allow = ulaw
allow = alaw
auth = ramal-1002-auth
aors = ramal-1002-aor
callerid = "Teste Conectividade" <1002>

; --- Ramal 9001 — WebRTC Softphone (React) ---
[ramal-9001-auth]
type = auth
auth_type = userpass
username = 9001
password = webrtc9001pass
; realm deve bater com o domínio SIP usado pelo browser
realm = ${SIP_DOMAIN}

[ramal-9001-aor]
type = aor
max_contacts = 1
remove_existing = yes
; WebRTC precisa de contato qualificado
qualify_frequency = 30

[9001]
type = endpoint
; CRÍTICO: transport-ws para receber REGISTER via WebSocket
transport = transport-ws
context = ramais-webrtc
disallow = all
allow = opus
allow = ulaw
allow = alaw
auth = ramal-9001-auth
aors = ramal-9001-aor
callerid = "WebRTC React" <9001>
; CRÍTICO: identifica pelo username do Authorization digest
; 'auth_username' usa o campo username do REGISTER com credenciais
; necessário porque o Contact header tem domínio .invalid (RFC 7118)
identify_by = auth_username
; WebRTC — habilita todas as opções necessárias
webrtc = yes
; Opções explícitas (webrtc=yes ativa, mas declarar evita bugs em Asterisk 20)
dtls_auto_generate_cert = yes
use_avpf = yes
media_encryption = dtls
ice_support = yes
rtcp_mux = yes
; Necessário para WebRTC por trás de NAT/proxy
force_rport = yes
rewrite_contact = yes

; ---------------------------------------------------------------
; NOTA: Chamadas de saída (Módulo 2 e 3) usam o mesmo [tronco-sip]
; acima. O endpoint de saída separado [trunk-saida] foi removido.
; Channel AMI: PJSIP/<numero>@tronco-sip
; ---------------------------------------------------------------

