# =============================================================
# AsteriskIA — Template de Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env no repositório.
# =============================================================

# --- PostgreSQL ---
POSTGRES_DB=asteriskia
POSTGRES_USER=asteriskia
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_PORT=5432

# --- Asterisk ---
AST_AMI_HOST=asterisk
AST_AMI_PORT=5038
AST_AMI_USER=asteriskia
AST_AMI_PASSWORD=changeme_ami_password
# Extensão de saída do tronco SIP (usado pelo scheduler e módulo 3)
AST_OUTBOUND_TRUNK=tronco-sip
AST_OUTBOUND_CONTEXT=discagem-sainte

# --- Tronco SIP (preencher após confirmar com a operadora) ---
SIP_TRUNK_HOST=sip.operadora.com.br
SIP_TRUNK_USER=usuario_tronco
SIP_TRUNK_PASSWORD=senha_tronco
SIP_TRUNK_FROM_DOMAIN=sip.operadora.com.br

# --- Audiosocket ---
AUDIOSOCKET_HOST=ai-agent
AUDIOSOCKET_PORT=9092

# --- Backend Spring Boot ---
BACKEND_PORT=8080
BACKEND_JWT_SECRET=changeme_jwt_secret_256bits
BACKEND_ALLOWED_ORIGINS=http://localhost:3000,http://localhost

# --- Frontend React ---
REACT_APP_API_URL=http://localhost:8080/api/v1

# --- Google Gemini API ---
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL_STT=gemini-2.0-flash
GEMINI_MODEL_LLM=gemini-2.0-flash
GEMINI_MODEL_TTS=gemini-2.5-flash-preview-tts

# --- Jira Cloud ---
JIRA_BASE_URL=https://sua-empresa.atlassian.net
JIRA_USER_EMAIL=seu-email@empresa.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=PROJ

# --- Zabbix (Módulo 3) ---
ZABBIX_API_URL=https://zabbix.sua-empresa.com/api_jsonrpc.php
ZABBIX_USER=readonly_api_user
ZABBIX_PASSWORD=changeme_zabbix_password
# Severidade mínima: 2=Warning, 3=Average, 4=High, 5=Disaster
ZABBIX_MIN_SEVERITY=4
# Intervalo de polling em minutos
ZABBIX_POLL_INTERVAL_MINUTES=5

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# --- Monitoração ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_grafana_password

# --- Armazenamento de Áudio ---
# Caminho interno do container para gravar os áudios das chamadas
AUDIO_STORAGE_PATH=/var/asteriskia/recordings
