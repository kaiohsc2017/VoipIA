# =============================================================================
# VoipIA — Template de variáveis de ambiente
# Copie para .env e preencha os valores reais.
# NUNCA commite o arquivo .env no repositório.
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=asteriskia
POSTGRES_USER=asteriskia
POSTGRES_PASSWORD=changeme_strong_password
# Porta exposta no host para acesso direto (psql, DBeaver). Opcional em produção.
POSTGRES_PORT=5432

# ── Asterisk ──────────────────────────────────────────────────────────────────
AST_AMI_HOST=asterisk
AST_AMI_PORT=5038
AST_AMI_USER=asteriskia
AST_AMI_PASSWORD=changeme_ami_password
# Usuário/senha da REST API + WebSocket ARI (motor de fluxo do Call Center) —
# porta 8088, nunca publicada no host (ver AST_AMI_PASSWORD acima)
AST_ARI_USER=asteriskia
AST_ARI_PASSWORD=changeme_ari_password
# Extensão e contexto de saída pelo tronco SIP
AST_OUTBOUND_TRUNK=tronco-sip
AST_OUTBOUND_CONTEXT=discagem-sainte

# ── Tronco SIP — peer IP-based (sem usuário/senha) ───────────────────────────
# Autenticação fechada por IP com a operadora: 186.233.141.64
SIP_TRUNK_HOST=186.233.141.64
SIP_TRUNK_FROM_DOMAIN=voiphash.com.br

# IP público do VPS — obrigatório para NAT correto do RTP (Docker isola o Asterisk)
# Obtenha com: curl -s ifconfig.me
SIP_PUBLIC_IP=SEU_IP_PUBLICO

# Senhas SIP dos ramais — injetadas no pjsip.conf no boot (NUNCA versionar).
# Gere cada uma com: openssl rand -hex 16
# RAMAL_9001_PASSWORD DEVE ser igual a VITE_SIP_PASSWORD (softphone WebRTC).
RAMAL_1001_PASSWORD=changeme_ramal_1001
RAMAL_1002_PASSWORD=changeme_ramal_1002
RAMAL_9001_PASSWORD=changeme_ramal_9001
RAMAL_9002_PASSWORD=changeme_ramal_9002

# ── AudioSocket ───────────────────────────────────────────────────────────────
AUDIOSOCKET_HOST=ai-agent
AUDIOSOCKET_PORT=9092

# ── Backend Spring Boot ───────────────────────────────────────────────────────
BACKEND_JWT_SECRET=changeme_jwt_secret_256bits
# Gere um valor seguro com: openssl rand -hex 32

# Origens CORS permitidas pelo backend.
# Produção com HTTPS: https://app.voiphash.com.br (sem trailing slash)
BACKEND_ALLOWED_ORIGINS=https://app.voiphash.com.br

# Credenciais da interface web (admin único — alterar em produção)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_admin_password

# Chave compartilhada para autenticação interna (AI Agent ↔ Backend)
# Gere com: openssl rand -hex 32
INTERNAL_API_KEY=changeme_internal_api_key_32chars

# ── Frontend React (Vite) ─────────────────────────────────────────────────────
# ⚠️  Variáveis VITE_ são injetadas em BUILD TIME.
#    Ao alterar qualquer VITE_ em produção, rebuilde o container:
#    docker compose build frontend && docker compose up -d frontend
VITE_API_URL=https://app.voiphash.com.br/api/v1
VITE_ASTERISK_WS=wss://app.voiphash.com.br/asterisk-ws
VITE_SIP_URI=sip:9001@app.voiphash.com.br
VITE_SIP_PASSWORD=webrtc9001pass
# Servidor STUN para ICE do softphone WebRTC (descoberta de IP público)
VITE_STUN_URL=stun:stun.l.google.com:19302

# ── TURN (coturn — relay de RTP quando STUN não basta, ex: NAT simétrico) ─────
# TURN_CREDENTIAL e VITE_TURN_CREDENTIAL DEVEM ser iguais (mesma credencial
# usada pelo coturn e pelo cliente WebRTC para autenticar no relay).
TURN_CREDENTIAL=your_turn_credential_here
VITE_TURN_URL=turn:your_public_ip_here:3478
VITE_TURN_USER=asteriskia
VITE_TURN_CREDENTIAL=your_turn_credential_here

# ── Google Gemini API ─────────────────────────────────────────────────────────
GEMINI_API_KEY=your_google_gemini_api_key_here
# ⚠️  gemini-2.0-flash foi descontinuado — use gemini-2.5-flash
GEMINI_MODEL_STT=gemini-2.5-flash
GEMINI_MODEL_LLM=gemini-2.5-flash
GEMINI_MODEL_TTS=gemini-2.5-flash-preview-tts

# ── Jira Cloud ────────────────────────────────────────────────────────────────
JIRA_BASE_URL=https://sua-empresa.atlassian.net
JIRA_USER_EMAIL=seu-email@empresa.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=PROJ
# Intervalo (minutos) do job que sincroniza status/resolução dos chamados abertos de volta do Jira
JIRA_SYNC_POLL_INTERVAL_MINUTES=15

# ── Zabbix ────────────────────────────────────────────────────────────────────
ZABBIX_API_URL=https://zabbix.sua-empresa.com/api_jsonrpc.php
ZABBIX_USER=readonly_api_user
ZABBIX_PASSWORD=changeme_zabbix_password
# Severidade mínima para alertas: 2=Warning 3=Average 4=High 5=Disaster
ZABBIX_MIN_SEVERITY=4
ZABBIX_POLL_INTERVAL_MINUTES=5

# ── Telegram Bot ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# ── Armazenamento de áudio ────────────────────────────────────────────────────
AUDIO_STORAGE_PATH=/var/spool/asterisk/monitor

# ── Call Center — gravação de voz e chat (Fase 3/7/11/20 do plano omnicanal) ─
# Bind mount direto no host (não volume nomeado) — igual /opt/audio do Insights.
# Fase 20: caminhos padronizados sob /opt/VoipIA/media/ (git-ignorado, ver .gitignore) —
# antes /opt/gravacoes/audio e /opt/gravacoes/chat.
CALLCENTER_RECORDING_PATH=/opt/VoipIA/media/gravacao
CALLCENTER_CHAT_TRANSCRIPT_PATH=/opt/VoipIA/media/chat
# Fase 24: a fila do widget de chat interno virou configuração de banco (aba Canais do Call
# Center) — não é mais variável de ambiente. Origens liberadas no CORS do widget (comma-separated;
# vazio = nenhuma origem cross-origin liberada até configurar de verdade a intranet real).
CALLCENTER_CHAT_ALLOWED_ORIGINS=

# ── Insights — upload de análise sob demanda (Quality Management, V40) ──────
# Fase 20: /opt/audio_upload → /opt/VoipIA/media/sobdemanda.
INSIGHTS_UPLOAD_AUDIO_DIR=/opt/VoipIA/media/sobdemanda

# ── Insights — gravações do call center corporativo Verint ──────────────────
# Módulo apartado do domínio Asterisk — reusa GEMINI_API_KEY/GEMINI_MODEL_STT/
# GEMINI_MODEL_LLM já configurados acima. /opt/audio é compartilhado com outros
# serviços no host — nunca aponte pra um diretório exclusivo sem os pares
# {call_ref}---{uuid}.wav/.xml do Verint.
INSIGHTS_AUDIO_DIR=/opt/audio
INSIGHTS_POLL_INTERVAL_SECONDS=60
INSIGHTS_MAX_CONCURRENCY=2

# ── Plataforma de Agentes — LLM ──────────────────────────────────────────────
# Provedor ativo: google | anthropic | openai | minimax | openai_compat
AGENTS_LLM_PROVIDER=google
AGENTS_LLM_MODEL=gemini-2.5-flash
# false por padrão — habilite explicitamente ao configurar a chave
AGENTS_LLM_ENABLED=false
AGENTS_LLM_GOOGLE_KEY=    # deixe vazio para herdar GEMINI_API_KEY
AGENTS_LLM_ANTHROPIC_KEY=
AGENTS_LLM_OPENAI_KEY=
AGENTS_LLM_MINIMAX_KEY=
AGENTS_LLM_MINIMAX_GROUP_ID=
# URL base para APIs compatíveis com OpenAI (Ollama, Groq, Together…)
AGENTS_LLM_COMPAT_URL=http://localhost:11434/v1
AGENTS_LLM_COMPAT_KEY=
