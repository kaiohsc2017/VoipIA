# ============================================
# .gitignore — AsteriskIA
# ============================================

# Variáveis de ambiente (NUNCA commitar)
.env

# --- Java / Maven ---
backend/target/
backend/.mvn/
*.class
*.jar
*.war
*.ear

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
ai-agent/.venv/
scheduler/.venv/
*.egg-info/

# --- Node.js / React ---
frontend/node_modules/
frontend/build/
frontend/dist/
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# --- IDEs ---
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Docker ---
.docker/

# --- Gravações de áudio (dados sensíveis) ---
recordings/

# --- Logs ---
*.log
logs/
