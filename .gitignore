# ============================================
# .gitignore — VoipIA
# ============================================

# Variáveis de ambiente (NUNCA commitar)
.env

# Credenciais anotadas manualmente (PAT do GitHub, chaves) — NUNCA commitar
git.txt

# Arquivos soltos antigos e backups de banco — organizados fora do controle
# de versão (podem conter dumps/credenciais anotadas manualmente)
old/
backups/

# Diretório de secrets de produção — NÃO É PARTE DO REPOSITÓRIO
# Fica em /opt/VoipIA/env/ na VPS (fora do git working tree)
env/

# Fase 20 (plano Call Center Parte III) — mídia de produção (gravação de chamada, transcript de
# chat, biblioteca de anúncios, upload de análise sob demanda) passou a viver sob a raiz do repo
# (/opt/VoipIA/media/) em vez de /opt/gravacoes/. É dado de cliente/PII — NUNCA pode ser
# commitado, nem por acidente de um `git add -A`. Ignorado ANTES do bind mount existir (verificado
# com `git check-ignore -v media/`), reforçado por .git/hooks/pre-commit e por media/.gitignore.
# "media/*" (não "media/") de propósito — um diretório ignorado como unidade impede o git de
# aplicar a negação abaixo, então o próprio media/.gitignore ficaria de fora do controle de versão.
media/*
!media/.gitignore

# Configs Asterisk COM credenciais reais (versionadas como .template)
# O arquivo .template fica no git; o real fica no servidor ou é gerado
asterisk/config/pjsip.conf
asterisk/config/manager.conf
asterisk/config/extensions.conf
asterisk/config/ari.conf
asterisk/config/res_pgsql.conf
asterisk/config/sorcery.conf
asterisk/config/extconfig.conf

# --- Java / Maven ---
backend/target/
backend/.mvn/
*.class
*.jar
*.war
*.ear

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
ai-agent/.venv/
scheduler/.venv/
*.egg-info/

# --- Node.js / React ---
frontend/node_modules/
frontend/build/
frontend/dist/
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
insights-platform/frontend/node_modules/
insights-platform/frontend/dist/
agents-platform/frontend/node_modules/
agents-platform/frontend/dist/
callcenter-platform/frontend/node_modules/
callcenter-platform/frontend/dist/

# --- IDEs ---
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Docker ---
.docker/

# --- Gravações de áudio (dados sensíveis) ---
recordings/

# --- Logs ---
*.log
/logs/

# --- Backups e arquivos temporários locais ---
*.bak*
bkp-config/
security/config/action.d/

# --- Arquivos de estado runtime (gerados em execução, não versionar) ---
security/state/
asterisk/config/acl.conf

# --- Claude Code (sessão local — não versionar) ---
.claude/settings.local.json

# --- Diretório de trabalho local temporário (nunca vai pro git/Azure) ---
area/
