# =============================================================================
# Caddyfile — AsteriskIA
# AsteriskIA Telecom : rotas principais (/, /api/*, /ws/*, /asterisk-ws*)
# AsteriskIA Agentes : rotas sob /agents/*
# =============================================================================

{
    admin "0.0.0.0:2019"
}

app.voiphash.com.br {

    # ── AsteriskIA Agentes — API ──────────────────────────────────────────────
    @agents-api {
        path /agents/api/*
    }
    handle @agents-api {
        uri strip_prefix /agents
        reverse_proxy agents-backend:8000
    }

    # ── AsteriskIA Agentes — WebSocket logs em tempo real ─────────────────────
    @agents-ws {
        header Connection *Upgrade*
        header Upgrade websocket
        path /agents/ws/*
    }
    handle @agents-ws {
        uri strip_prefix /agents
        reverse_proxy agents-backend:8000
    }

    # ── AsteriskIA Agentes — Frontend ─────────────────────────────────────────
    @agents-ui {
        path /agents*
    }
    handle @agents-ui {
        uri strip_prefix /agents
        uri replace "" "/"
        reverse_proxy agents-frontend:80
    }

    # ── AsteriskIA Telecom — API backend Spring Boot ──────────────────────────
    @api {
        path /api/*
    }
    handle @api {
        reverse_proxy asteriskia-backend:8080
    }

    # ── AsteriskIA Telecom — WebSocket backend ────────────────────────────────
    @ws {
        header Connection *Upgrade*
        header Upgrade websocket
        path /ws/*
    }
    handle @ws {
        reverse_proxy asteriskia-backend:8080
    }

    # ── AsteriskIA Telecom — WebSocket Asterisk (softphone WebRTC) ───────────
    @asterisk-ws {
        header Connection *Upgrade*
        header Upgrade websocket
        path /asterisk-ws*
    }
    handle @asterisk-ws {
        rewrite * /ws
        reverse_proxy asteriskia-asterisk:8088
    }

    # ── AsteriskIA Telecom — Frontend React ───────────────────────────────────
    handle {
        reverse_proxy asteriskia-frontend:80
    }
}

# ── Documentação e scripts de instalação ────────────────────────────────────
app.voiphash.com.br/docs/* {
    root * /opt/AsteriskIA/docs
    file_server
}

app.voiphash.com.br/install.sh {
    root * /opt/AsteriskIA
    file_server
    header Content-Type text/plain
}

# ── Grafana ───────────────────────────────────────────────────────────────────
app.voiphash.com.br:3000 {
    reverse_proxy asteriskia-grafana:3000
}

# ── Prometheus ────────────────────────────────────────────────────────────────
app.voiphash.com.br:9090 {
    reverse_proxy asteriskia-prometheus:9090
}
