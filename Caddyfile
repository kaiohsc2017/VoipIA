# =============================================================================
# Caddyfile — AsteriskIA
# Proxy reverso HTTPS com TLS automático (Let's Encrypt).
#
# Rotas:
#   app.voiphash.com.br        → Telecom (frontend + API + WebSockets)
#   app.voiphash.com.br/agents → Plataforma de Agentes (frontend + API + WS)
#   app.voiphash.com.br/docs   → Documentação estática (HTML)
#   claw.voiphash.com.br       → Proxy interno (10.0.3.1:18789)
# =============================================================================

{
    # API de administração — acessível apenas internamente (rede Docker)
    admin "0.0.0.0:2019"
}

app.voiphash.com.br {

    # ── Agentes — API (FastAPI) ───────────────────────────────────────────────
    # Prefixo /agents é removido antes de encaminhar ao backend de agentes.
    @agents-api {
        path /agents/api/*
    }
    handle @agents-api {
        uri strip_prefix /agents
        reverse_proxy asteriskia-agents-api:8000
    }

    # ── Agentes — WebSocket (logs em tempo real) ──────────────────────────────
    @agents-ws {
        header Connection *Upgrade*
        header Upgrade websocket
        path /agents/ws/*
    }
    handle @agents-ws {
        uri strip_prefix /agents
        reverse_proxy asteriskia-agents-api:8000
    }

    # ── Agentes — Frontend (React SPA servida pelo nginx do frontend) ─────────
    @agents-ui {
        path /agents*
    }
    handle @agents-ui {
        uri strip_prefix /agents
        uri replace "" "/"
        reverse_proxy asteriskia-frontend:80
    }

    # ── Documentação estática ─────────────────────────────────────────────────
    # Arquivos HTML servidos diretamente pelo Caddy a partir do volume montado.
    @docs {
        path /docs/*
    }
    handle @docs {
        root * /srv/docs
        file_server
    }

    # ── Telecom — API (Spring Boot) ───────────────────────────────────────────
    @api {
        path /api/*
    }
    handle @api {
        reverse_proxy asteriskia-backend:8080
    }

    # ── Telecom — WebSocket STOMP (dashboard em tempo real) ───────────────────
    @ws {
        header Connection *Upgrade*
        header Upgrade websocket
        path /ws/*
    }
    handle @ws {
        reverse_proxy asteriskia-backend:8080
    }

    # ── Telecom — WebSocket Asterisk (softphone WebRTC) ──────────────────────
    # Caddy termina TLS (wss://) e repassa como ws:// para o Asterisk na 8088.
    @asterisk-ws {
        header Connection *Upgrade*
        header Upgrade websocket
        path /asterisk-ws*
    }
    handle @asterisk-ws {
        rewrite * /ws
        reverse_proxy asteriskia-asterisk:8088
    }

    # ── Telecom — Frontend React (catch-all) ──────────────────────────────────
    handle {
        reverse_proxy asteriskia-frontend:80
    }
}

# ── Claw — proxy para serviço interno ────────────────────────────────────────
claw.voiphash.com.br {
    reverse_proxy 10.0.3.1:18789 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
    }
}
